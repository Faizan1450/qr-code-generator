<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Generate QR</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="./styles.css" />
  </head>
  <body>
    <div class="container">
      <form action="/generate" method="post">
        <h2>Generate QR Codes</h2>
        <div class="mb3">
          <div class="input-group row">
            <div class="col-md-10">
              <input
                type="url"
                name="url"
                id="url"
                placeholder="Enter an URL"
                class="form-control"
                required
              />
            </div>
            <button
              type="submit"
              id="btn-submit"
              class="btn btn-success col-md-2"
            >
              Validate
            </button>
          </div>
          <div
            class="alert alert-warning"
            role="alert"
            style="display: none"
            id="alert"
          >
            A simple warning alert—check it out!
          </div>
        </div>
      </form>
      <% if (image) { %>
      <div id="img">
        <h2>Your QR Code:</h2>
        <img src="<%= image %>" alt="QR Code" />
      </div>
      <script>
        document.getElementById("url").value = "<%=url%>";
      </script>
      <% } %>
    </div>
    <script>
      const btnSubmit = document.getElementById("btn-submit");
      const url = document.getElementById("url");
      const img = document.getElementById("img");
      const alertMsg = document.getElementById("alert");
      url.addEventListener("keypress", (e) => {
        btnSubmit.innerText = "Validate"
        btnSubmit.classList.remove("btn-primary");
        btnSubmit.classList.add("btn-success");
      })
      btnSubmit.addEventListener("click", (e) => {
        if (btnSubmit.innerText === "Validate") {
          e.preventDefault();
          if (url.value === "" || url.value === null) {
            alertMsg.innerText = "Cannot validate empty! Please Enter an URL";
            alertMsg.style.display = "block";
            img.style.display = "none";
            alert("Cannot validate empty! Please Enter an URL");
          } else if (!isValidURL(url.value)) {
            alertMsg.innerText =
              "Enter a correct url eg: https://example.com";
            alertMsg.style.display = "block";
            img.style.display = "none";
            alert("Enter a correct url \neg: https://example.com");
          } else {
            btnSubmit.innerText = "Generate";
            btnSubmit.classList.add("btn-primary");
            btnSubmit.classList.remove("btn-success");
            alertMsg.style.display = "none";
            img.style.display = "none";
          }
          return;
        }
      });
      function isValidURL(url) {
        try {
          new URL(url);
          return true;
        } catch (err) {
          return false;
        }
      }
    </script>
  </body>
</html>
